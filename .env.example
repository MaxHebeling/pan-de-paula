# ─── Entorno ────────────────────────────────────────────────────────────────
# development | staging | production
APP_ENV=development
LOG_LEVEL=info
# Zona horaria de formato en el CRM (debe coincidir con business_settings.timezone)
BUSINESS_TZ=America/Tijuana

# ─── Base de datos (Postgres / Supabase) ────────────────────────────────────
# Local:   postgres://USER@localhost:5432/pan_de_paula
# Supabase: usar el pooler en modo transaction (puerto 6543) para serverless.
DATABASE_URL=postgres://localhost:5432/pan_de_paula
DATABASE_URL_TEST=postgres://localhost:5432/pan_de_paula_test
# "require" en Supabase / producción, "disable" en local
DATABASE_SSL=disable
# CA raíz de Supabase (PEM en una línea con \n) para verificar el certificado del pooler con DATABASE_SSL=require
DATABASE_CA_CERT=
# Opcional: URL para respaldos (pooler en modo sesión, puerto 5432). Si falta se usa DATABASE_URL.
BACKUP_DATABASE_URL=
# Rol propietario para migraciones (postgres.<ref> por el pooler en modo sesión 5432). La app usa pdp_app.
MIGRATE_DATABASE_URL=

# ─── Sesiones / Auth (admin) ────────────────────────────────────────────────
# 32+ bytes aleatorios: `openssl rand -base64 48`
SESSION_SECRET=CAMBIAME-openssl-rand-base64-48

# ─── URLs públicas ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ─── Mercado Pago México ────────────────────────────────────────────────────
# Credenciales de PRODUCCIÓN o de PRUEBA desde https://www.mercadopago.com.mx/developers/panel
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# "Clave secreta" del webhook (Panel > Webhooks > Configurar notificaciones)
MERCADOPAGO_WEBHOOK_SECRET=
# ID del dispositivo Point (opcional; solo si se usa terminal Point). Se obtiene con GET /terminals.
MERCADOPAGO_POINT_DEVICE_ID=
# Caja (POS) externa para QR dinámico vía API de Órdenes (opcional; POST /pos → external_id)
MERCADOPAGO_QR_EXTERNAL_POS_ID=

# ─── Meta / Instagram Messaging ─────────────────────────────────────────────
META_APP_SECRET=
META_VERIFY_TOKEN=CAMBIAME-token-de-verificacion
# Token de larga duración con instagram_business_manage_messages (Instagram Login) o Page token (Facebook Login)
INSTAGRAM_PAGE_ACCESS_TOKEN=
# ID de la cuenta profesional de Instagram (entry.id en los webhooks) o de la Página si se usa Facebook Login
INSTAGRAM_ACCOUNT_ID=
# Base del Send API. Instagram Login: https://graph.instagram.com/v25.0 (default). Facebook Login: https://graph.facebook.com/v25.0
INSTAGRAM_API_BASE=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="El Pan de Paula <pedidos@elpandepaula.mx>"

# ─── Almacenamiento de imágenes ─────────────────────────────────────────────
# local | supabase
STORAGE_DRIVER=local
# Solo driver local (opcional): carpeta `public` donde se escriben /uploads. Por defecto apps/admin/public.
STORAGE_LOCAL_ROOT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ─── Observabilidad ─────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Jobs / Cron ────────────────────────────────────────────────────────────
# Protege /api/cron/*  (`openssl rand -hex 32`). Mínimo 16 caracteres: con menos, isCronAuthorized rechaza todo (401).
CRON_SECRET=CAMBIAME

# ─── IA (bot de Instagram, opcional) ────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Seed / E2E ─────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@elpandepaula.local
SEED_ADMIN_PASSWORD=CambiaEstaClave!2026
E2E_BASE_URL=http://localhost:3001
E2E_WEB_URL=http://localhost:3000
E2E_ADMIN_EMAIL=admin@elpandepaula.local
E2E_ADMIN_PASSWORD=CambiaEstaClave!2026
